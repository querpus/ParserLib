/debug+
/debug:portable
/filealign:512
/optimize-
/out:obj/x64/Debug/net11.0/UnitTest.dll
/refout:obj/x64/Debug/net11.0/refint/UnitTest.dll
/target:exe
/warnaserror-
/utf8output
/deterministic+
/langversion:preview
/warnaserror+:NU1605,SYSLIB0011

